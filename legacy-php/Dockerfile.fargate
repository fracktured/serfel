# Real combined image: Distribuidor (raw PHP, mysql_*) + SerfelWeb (CodeIgniter,
# mysqli), one Apache doc root. PHP 5.6 is EOL. Built ARM64 to match the task def.
FROM php:5.6-apache

# soap (SoapClient, used by Clases/WS/FacturacionClWS.php for e-invoicing)
# needs libxml2-dev headers to compile.
# PHP 5.6's base image is Debian stretch (EOL): its mirrors are gone, so repoint
# apt to archive.debian.org and drop stretch-updates before installing.
# Container runs in America/Santiago so PHP date/time and Apache logs use
# Chilean local time (tzdata sets /etc/localtime; date.timezone in the ini
# below covers PHP itself).
ENV TZ=America/Santiago

RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf \
    && sed -i '/stretch-updates/d' /etc/apt/sources.list \
    && sed -i 's|deb.debian.org|archive.debian.org|g; s|security.debian.org|archive.debian.org|g' /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends --allow-unauthenticated libxml2-dev tzdata \
    && ln -sf /usr/share/zoneinfo/America/Santiago /etc/localtime \
    && echo "America/Santiago" > /etc/timezone \
    && rm -rf /var/lib/apt/lists/* \
    && docker-php-ext-install mysql mysqli pdo pdo_mysql mbstring soap \
    && a2enmod rewrite

# SerfelWeb relies on .htaccess rewrites — enable AllowOverride for the doc root.
RUN printf '<Directory /var/www/html/>\n    AllowOverride All\n    Require all granted\n</Directory>\n' \
      > /etc/apache2/conf-available/allow-override.conf \
    && a2enconf allow-override

# PHP 5.6 trae max_execution_time = 30, que abortaba "Descargar seleccionadas"
# (concatenar ~100 facturas) antes de tiempo. Este ini lo sube (ver php-rehost.ini).
COPY php-rehost.ini /usr/local/etc/php/conf.d/zz-rehost.ini

COPY Distribuidor/ /var/www/html/Distribuidor/
COPY SerfelWeb/   /var/www/html/SerfelWeb/
# Coproad (second business) is served under the /coproad/* URL prefix, so nest
# both apps under a coproad/ dir in the doc root to match (CloudFront forwards
# the full /coproad/... path to the ALB; there is no edge prefix strip).
COPY Coproad/     /var/www/html/coproad/Coproad/
COPY CoproadWeb/  /var/www/html/coproad/CoproadWeb/
COPY health.php   /var/www/html/health.php

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD curl -f http://localhost/health.php || exit 1
