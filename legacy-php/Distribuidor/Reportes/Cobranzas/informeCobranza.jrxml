					<font fontName="Verdana" size="13" isBold="true"/>
				</textElement>
				<text><![CDATA[Fecha Informe:  ]]></text>
			</staticText>
			<textField>
				<reportElement x="294" y="55" width="170" height="15"/>
				<textElement verticalAlignment="Bottom">
					<font fontName="Verdana" size="13"/>
					<paragraph leftIndent="5"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{fechaInforme}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="524" y="70" width="30" height="12"/>
				<textElement textAlignment="Right">
					<font fontName="Verdana" size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="474" y="70" width="50" height="12"/>
				<textElement textAlignment="Right" verticalAlignment="Bottom">
					<font fontName="Verdana" size="9"/>
					<paragraph rightIndent="5"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{txtPagina}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="85" width="70" height="16"/>
				<textElement textAlignment="Center">
					<font fontName="Verdana" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Factura]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="85" width="180" height="16"/>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="Verdana" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Razon Social]]></text>
			</staticText>
			<staticText>
				<reportElement x="250" y="85" width="70" height="16" backcolor="#CCCCFF"/>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="Verdana" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Rut Cliente]]></text>
			</staticText>
			<staticText>
				<reportElement x="380" y="85" width="70" height="16"/>
				<textElement textAlignment="Center">
					<font fontName="Verdana" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[x Pagar]]></text>
			</staticText>
			<staticText>
				<reportElement x="320" y="85" width="70" height="16"/>
				<textElement textAlignment="Center">
					<font fontName="Verdana" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Cond. Pago]]></text>
			</staticText>
			<staticText>
				<reportElement x="450" y="85" width="95" height="16"/>
				<textElement textAlignment="Center">
					<font fontName="Verdana" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Observaciones]]></text>
			</staticText>
			<line>
				<reportElement x="0" y="100" width="554" height="1"/>
			</line>
		</band>
	</pageHeader>
	<detail>
		<band height="18" splitType="Stretch">
			<textField>
				<reportElement x="250" y="1" width="70" height="17"/>
				<textElement textAlignment="Right">
					<font fontName="Verdana" size="11"/>
					<paragraph rightIndent="10"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{rut_cliente}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="70" y="1" width="180" height="17"/>
				<textElement>
					<font fontName="Verdana" size="11"/>
					<paragraph leftIndent="5"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{razon_social}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="1" width="70" height="17"/>
				<textElement textAlignment="Center">
					<font fontName="Verdana" size="11"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{num_docto_emitido}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="320" y="1" width="70" height="17"/>
				<textElement textAlignment="Right">
					<font fontName="Verdana" size="11"/>
					<paragraph rightIndent="20"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nom_tipo_docto}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="380" y="1" width="70" height="17"/>
				<textElement textAlignment="Right">
					<font fontName="Verdana" size="11"/>
					<paragraph rightIndent="20"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{precio_total}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="450" y="17" width="105" height="1"/>
			</line>
		</band>
	</detail>
	<summary>
		<band height="50">
			<staticText>
				<reportElement x="270" y="20" width="50" height="15"/>
				<textElement>
					<font fontName="Verdana" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Total:]]></text>
			</staticText>
			<staticText>
				<reportElement x="70" y="20" width="130" height="15"/>
				<textElement>
					<font fontName="Verdana" size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Cantidad Facturas:]]></text>
			</staticText>
			<textField>
				<reportElement x="170" y="22" width="100" height="15"/>
				<textElement>
					<font fontName="Verdana" size="11" isBold="true"/>
					<paragraph leftIndent="5"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{numFacturas}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="305" y="22" width="85" height="15"/>
				<textElement textAlignment="Right">
					<font fontName="Verdana" size="11" isBold="true"/>
					<paragraph rightIndent="20"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{total}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
