<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Rutario" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="idRuta" class="java.lang.Integer"/>
	<parameter name="idEstadoPago" class="java.lang.Integer"/>
	<parameter name="fechaInforme" class="java.lang.String"/>
	<parameter name="txtPagina" class="java.lang.String"/>
	<parameter name="nomRuta" class="java.lang.String"/>
	<parameter name="numFacturas" class="java.lang.String"/>
	<parameter name="total" class="java.lang.String"/>
	<queryString>
		<![CDATA[
		SELECT  CONCAT(v.rut_empresa, '-', e.dv_empresa) AS rut_empresa,
        		CONCAT(v.rut_cliente, '-', c.dv_cliente) AS rut_cliente,
        		c.razon_social,
        		CASE 
					WHEN v.id_tipo_docto_emitido = 1 THEN v.num_docto_emitido 
					ELSE v.id_folio 
				END AS num_docto_emitido,
        		v.precio_total 
					- COALESCE( (SELECT SUM(nc.precio_total) FROM 40_m_nota_credito nc WHERE nc.id_venta = v.id_venta), 0 ) 
					- COALESCE( (SELECT SUM(p.monto) FROM 60_m_pago p WHERE p.id_venta = v.id_venta), 0 ) 
				as precio_total,
				d.nom_tipo_docto
		FROM 40_m_ruta r
    		INNER JOIN 40_m_ruta_local_cliente rlc ON r.id_ruta = rlc.id_ruta
			INNER JOIN 40_m_venta v ON rlc.id_local_cliente = v.id_local_cliente
			INNER JOIN 10_m_cliente c ON v.rut_cliente = c.rut_cliente
			INNER JOIN 10_m_empresa e ON v.rut_empresa = e.rut_empresa
			INNER JOIN 10_p_tipo_docto d ON v.id_forma_pago = d.id_tipo_docto
		WHERE v.id_estado = 3
			AND r.id_ruta = $P{idRuta}
			AND ( v.id_estado_pago = $P{idEstadoPago}
                OR ( $P{idEstadoPago} = -1 AND id_estado_pago IN (1, 2) ) )
		ORDER BY v.num_docto_emitido
		]]>
	</queryString>
	<field name="rut_empresa" class="java.lang.String"/>
	<field name="rut_cliente" class="java.lang.String"/>
	<field name="razon_social" class="java.lang.String"/>
	<field name="num_docto_emitido" class="java.lang.Integer"/>
	<field name="precio_total" class="java.lang.Integer"/>
	<field name="nom_tipo_docto" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<pageHeader>
		<band height="101" splitType="Stretch">
			<staticText>
				<reportElement x="195" y="12" width="165" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Verdana" size="13" isBold="true"/>
				</textElement>
				<text><![CDATA[INFORME COBRANZAS]]></text>
