<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ListadoCarga" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="idRuta" class="java.lang.Integer"/>
	<parameter name="fechaInforme" class="java.lang.String"/>
	<parameter name="txtPagina" class="java.lang.String"/>
	<parameter name="nomRuta" class="java.lang.String"/>
	<parameter name="numFacturas" class="java.lang.String"/>
	<parameter name="total" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT  p.cod_serfel,
        p.nom_producto,
        m.nom_marca,
        um.nom_UM,
        CASE
	WHEN FLOOR(SUM(pv.cantidad)) != CEILING(SUM(pv.cantidad))
	  THEN CONVERT(SUM(pv.cantidad), DECIMAL(10, 2))
	ELSE CONVERT(SUM(pv.cantidad), UNSIGNED)
        END AS cantidad,
        CONVERT(SUM(pv.cantidad * (pv.precio - (pv.precio * pv.porcen_desc / 100))), UNSIGNED) AS subtotal
FROM 40_m_ruta r
    INNER JOIN 40_m_ruta_local_cliente rlc ON r.id_ruta = rlc.id_ruta
    INNER JOIN 40_m_venta v ON rlc.id_local_cliente = v.id_local_cliente
    INNER JOIN 40_m_producto_venta pv ON v.id_venta = pv.id_venta
    INNER JOIN 20_m_producto p ON pv.id_producto = p.id_producto
    INNER JOIN 20_p_marca m ON p.id_marca = m.id_marca
    INNER JOIN 20_p_unidad_medida um ON p.id_UM = um.id_UM
WHERE r.id_ruta IN ($P{idRuta})
    AND v.entregado = 0
    AND v.id_estado = 3
GROUP BY p.cod_serfel,
         p.nom_producto,
         m.nom_marca,
         um.nom_UM
ORDER BY CONCAT(LEFT(p.cod_serfel, 2), LPAD(SUBSTRING(p.cod_serfel, 3), 3, '00'))]]>
	</queryString>
	<field name="cod_serfel" class="java.lang.Integer"/>
	<field name="nom_producto" class="java.lang.String"/>
	<field name="nom_marca" class="java.lang.String"/>
	<field name="nom_UM" class="java.lang.String"/>
	<field name="precio_total" class="java.lang.Integer"/>
	<field name="cantidad" class="java.lang.String"/>
	<field name="subtotal" class="java.lang.Integer"/>
