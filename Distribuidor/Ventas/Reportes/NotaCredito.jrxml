	<parameter name="idNotaCredito" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT CONVERT(pnc.cantidad, UNSIGNED) AS cantidad,
       u.nom_UM,
       pr.nom_producto,
       pnc.precio,
       CONCAT(pnc.porcen_desc, '%') AS porcen_desc,
       CONVERT(pnc.cantidad * (pnc.precio + ((pnc.precio * pnc.porcen_desc) / 100)), UNSIGNED) as subtotal
FROM 40_m_nota_credito nc
INNER JOIN 40_m_prod_nota_credito pnc
    ON nc.id_nota_credito = pnc.id_nota_credito
INNER JOIN 20_m_producto pr ON pr.id_producto = pnc.id_producto
INNER JOIN 20_p_unidad_medida u ON u.id_UM = pr.id_UM
WHERE nc.id_nota_credito = $P{idNotaCredito}]]>
	</queryString>
	<field name="cantidad" class="java.math.BigDecimal"/>
	<field name="nom_UM" class="java.lang.String"/>
	<field name="nom_producto" class="java.lang.String"/>
	<field name="precio" class="java.lang.Integer"/>
	<field name="porcen_desc" class="java.lang.Integer"/>
	<field name="subtotal" class="java.math.BigDecimal"/>
